// Integrar estes blocos às regras existentes; este arquivo sozinho não libera as outras abas.
// Uma regra global "allow read, write: if true" deve EXCLUIR estas coleções.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function reportStudentIsActive(member) {
      return member.role == 'admin'
        || !exists(/databases/$(database)/documents/students/$(member.studentId))
        || get(/databases/$(database)/documents/students/$(member.studentId)).data.get('status', 'active') != 'inactive';
    }
    function isReportMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.role in ['admin', 'student']
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.email.lower() == request.auth.token.email.lower()
        && reportStudentIsActive(get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data);
    }
    function isReportAdmin() {
      return isReportMember()
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.role == 'admin';
    }
    // Biblioteca do Giro: a equipe lê somente publicados; técnicos gerenciam os materiais.
    function validGiroMaterial(data) {
      return data.keys().hasOnly(['title', 'category', 'status', 'tags', 'sourceURL', 'pages', 'textLength', 'fileName', 'version', 'seasonId', 'createdAt', 'updatedAt', 'revision'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 180
        && data.category in ['rubric', 'tournament', 'season', 'robot', 'project', 'general']
        && data.status in ['draft', 'published', 'archived']
        && data.tags is string && data.tags.size() <= 500
        && data.sourceURL is string && data.sourceURL.size() <= 2000
        && (data.sourceURL == '' || data.sourceURL.matches('https?://.*'))
        && data.pages is list && data.pages.size() >= 1 && data.pages.size() <= 200
        && data.textLength is int && data.textLength >= 20 && data.textLength <= 120000
        && data.fileName is string && data.fileName.size() <= 220 && data.version == 1
        && data.seasonId is string && data.createdAt is string && data.updatedAt is string
        && data.revision is int && data.revision >= 1;
    }
    function giroSeasonWritable(seasonId) {
      let settings = exists(/databases/$(database)/documents/settings/workspace_season)
        ? get(/databases/$(database)/documents/settings/workspace_season).data : {};
      return settings.get('activeSeasonId', 'legacy') == seasonId && settings.get('transitionLock', null) == null;
    }
    // Planejador de trajetos: equipe lê; autor e técnico editam na temporada ativa.
    function validRobotTrajectory(data) {
      let settings = data.settings;
      return data.keys().hasOnly(['title', 'roundId', 'exitNumber', 'notes', 'settings', 'points', 'obstacles', 'seasonId', 'ownerId', 'author', 'createdAt', 'updatedAt', 'updatedBy', 'revision'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        && data.roundId is string && data.roundId.size() <= 160
        && data.get('exitNumber', 0) is int && data.get('exitNumber', 0) >= 0 && data.get('exitNumber', 0) <= 8
        && data.notes is string && data.notes.size() <= 2000
        && data.points is list && data.points.size() >= 2 && data.points.size() <= 80
        && data.get('obstacles', []) is list && data.get('obstacles', []).size() <= 40
        && settings is map && settings.keys().hasOnly(['width', 'height', 'robotWidth', 'robotLength', 'heading', 'map', 'robotName', 'robotVersionId', 'gripperName', 'gripperId', 'gripperLength', 'gripperWidth', 'gripperX', 'gripperY'])
        && settings.width is number && settings.width >= 50 && settings.width <= 500
        && settings.height is number && settings.height >= 50 && settings.height <= 500
        && settings.robotWidth is number && settings.robotWidth >= 5 && settings.robotWidth <= 50
        && settings.robotLength is number && settings.robotLength >= 5 && settings.robotLength <= 50
        && settings.heading is number && settings.heading >= -180 && settings.heading <= 180
        && settings.map in ['grid', 'bioglow']
        && settings.get('robotName', '') is string && settings.get('robotName', '').size() <= 100
        && settings.get('gripperName', '') is string && settings.get('gripperName', '').size() <= 100
        && settings.get('robotVersionId', '') is string && settings.get('robotVersionId', '').size() <= 160
        && settings.get('gripperId', '') is string && settings.get('gripperId', '').size() <= 160
        && settings.get('gripperLength', 0) is number && settings.get('gripperLength', 0) >= 0 && settings.get('gripperLength', 0) <= 80
        && settings.get('gripperWidth', 0) is number && settings.get('gripperWidth', 0) >= 0 && settings.get('gripperWidth', 0) <= 80
        && settings.get('gripperX', 0) is number && settings.get('gripperX', 0) >= -100 && settings.get('gripperX', 0) <= 100
        && settings.get('gripperY', 0) is number && settings.get('gripperY', 0) >= -100 && settings.get('gripperY', 0) <= 100
        && data.seasonId is string && data.ownerId is string && data.author is string && data.author.size() <= 120
        && data.createdAt is string && data.updatedAt is string && data.updatedBy == request.auth.uid
        && data.revision is int && data.revision >= 1;
    }
    match /robotTrajectories/{planId} {
      allow read: if isReportMember();
      allow create: if isReportMember() && validRobotTrajectory(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.revision == 1
        && giroSeasonWritable(request.resource.data.seasonId);
      allow update: if isReportMember() && (isReportAdmin() || resource.data.ownerId == request.auth.uid)
        && validRobotTrajectory(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.author == resource.data.author
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.revision == resource.data.revision + 1 && giroSeasonWritable(resource.data.seasonId);
      // O encerramento reaplica seasonId nos registros; não permite mudar o plano.
      allow update: if isReportAdmin() && request.resource.data == resource.data;
      allow delete: if isReportMember() && (isReportAdmin() || resource.data.ownerId == request.auth.uid) && giroSeasonWritable(resource.data.seasonId);
    }
    match /giroKnowledgeMaterials/{materialId} {
      allow read: if isReportAdmin() || (isReportMember() && resource.data.status == 'published');
      allow create: if isReportAdmin() && validGiroMaterial(request.resource.data)
        && request.resource.data.revision == 1 && giroSeasonWritable(request.resource.data.seasonId);
      allow update: if isReportAdmin() && validGiroMaterial(request.resource.data)
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && giroSeasonWritable(resource.data.seasonId);
      allow delete: if false;
    }
    match /weeklyReportMembers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Avaliações nunca viram conhecimento automaticamente; só o técnico revisa.
    match /giroAnswerFeedback/{feedbackId} {
      allow read: if isReportAdmin() || (isReportMember() && resource.data.ownerId == request.auth.uid);
      allow create: if isReportMember()
        && request.resource.data.keys().hasOnly(['question', 'answer', 'note', 'rating', 'sources', 'ownerId', 'seasonId', 'status', 'correction', 'createdAt', 'reviewedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.seasonId is string && giroSeasonWritable(request.resource.data.seasonId)
        && request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 4000
        && request.resource.data.answer is string && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 16000
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.rating in ['helpful', 'incorrect']
        && request.resource.data.sources is list && request.resource.data.sources.size() <= 4
        && request.resource.data.status == 'open' && request.resource.data.correction == ''
        && request.resource.data.reviewedAt == '' && request.resource.data.createdAt is string;
      allow update: if isReportAdmin() && giroSeasonWritable(resource.data.seasonId)
        && resource.data.status == 'open' && request.resource.data.status == 'reviewed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'correction', 'reviewedAt'])
        && request.resource.data.correction is string && request.resource.data.correction.size() <= 4000
        && request.resource.data.reviewedAt is string;
      allow delete: if false;
    }
    // Contador do Giro IA: somente o servidor pode reservar o uso da API.
    match /giroAiUsage/{uid} {
      allow read, write: if false;
    }
    match /finalSprintTournamentDrafts/{seasonId} {
      allow read, write: if isReportAdmin();
    }
    // Giro: carteira privada, catálogo fixo e recibos únicos por contribuição.
    function isGearOwner(studentId) {
      return isReportMember()
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.role == 'student'
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.studentId == studentId;
    }
    function validWorkshopPoint(point, minX, maxX, minY, maxY) {
      return point is map && point.keys().hasOnly(['x', 'y']) && point.x is int && point.y is int
        && point.x >= minX && point.x <= maxX && point.y >= minY && point.y <= maxY;
    }
    function validGearWorkshop(data) {
      return data is map && data.keys().hasOnly(['layout', 'expression', 'updatedAt'])
        && data.expression in ['auto', 'happy', 'curious', 'focused', 'surprised']
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && data.layout is map && data.layout.keys().hasOnly(['bench', 'decor', 'giro', 'light'])
        && validWorkshopPoint(data.layout.bench, 120, 680, 250, 360)
        && validWorkshopPoint(data.layout.decor, 100, 700, 190, 320)
        && validWorkshopPoint(data.layout.giro, 135, 665, 275, 350)
        && validWorkshopPoint(data.layout.light, 230, 570, 34, 85);
    }
    // Merge this narrow update with the existing student permissions.
    match /students/{studentId} {
      allow update: if isGearOwner(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gearWorkshop'])
        && validGearWorkshop(request.resource.data.gearWorkshop);
      // Appearance is only a mirror of the validated wallet, including multiple accessories.
      allow update: if (isGearOwner(studentId) || isReportAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gearAppearance'])
        && request.resource.data.gearAppearance == getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data.equipped;
      match /gearWorkshopReactions/{actorId} {
        allow read: if isReportMember();
        allow create, update: if isGearOwner(actorId) && studentId != actorId
          && exists(/databases/$(database)/documents/students/$(studentId))
          && get(/databases/$(database)/documents/students/$(studentId)).data.get('status', 'active') != 'inactive'
          && request.resource.data.keys().hasOnly(['actorStudentId', 'targetStudentId', 'type', 'updatedAt'])
          && request.resource.data.actorStudentId == actorId && request.resource.data.targetStudentId == studentId
          && request.resource.data.type in ['creative', 'style', 'inspiring', 'none']
          && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
        allow delete: if false;
      }
    }
    function gearBefore(studentId) {
      let previous = exists(/databases/$(database)/documents/studentGearProfiles/$(studentId))
        ? get(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data : {};
      let equipped = previous.get('equipped', {});
      let defaults = ['skin-nebula', 'frame-none', 'accessory-none', 'title-team', 'room-base', 'bench-base', 'light-base', 'decor-base', 'animation-default'];
      // Normalize older wallets without charging for the starter workshop.
      return {'balance': previous.get('balance', 40), 'earned': previous.get('earned', 40), 'spent': previous.get('spent', 0),
           'refundCount': previous.get('refundCount', 0),
           'refundableItems': previous.get('refundableItems', previous.get('spent', 0) > 0 ? previous.get('owned', []).removeAll(defaults) : []),
           'owned': defaults.concat(previous.get('owned', []).removeAll(defaults)),
           'equipped': equipped.keys().hasAny(['accessories']) ? equipped : {'skin': equipped.get('skin', 'skin-nebula'),
             'frame': equipped.get('frame', 'frame-none'),
             'accessory': equipped.get('accessory', 'accessory-none'),
             'title': equipped.get('title', 'title-team'),
             'room': equipped.get('room', 'room-base'),
             'bench': equipped.get('bench', 'bench-base'),
             'light': equipped.get('light', 'light-base'),
             'decor': equipped.get('decor', 'decor-base'),
             'animation': equipped.get('animation', 'animation-default')},
           'rewardDay': previous.get('rewardDay', ''), 'rewardDayIndex': previous.get('rewardDayIndex', -1),
           'dayEarned': previous.get('dayEarned', 0), 'dayCounts': previous.get('dayCounts', {}),
           'growthPoints': previous.get('growthPoints', 0), 'contributionCounts': previous.get('contributionCounts', {})};
    }
    function gearPrice(id) {
      return {'skin-nebula': 0,
              'skin-solar': 25,
              'skin-emerald': 35,
              'skin-rose': 45,
              'skin-arctic': 65,
              'skin-lava': 85,
              'frame-none': 0,
              'frame-orbit': 20,
              'frame-hex': 40,
              'frame-stars': 60,
              'frame-champion': 100,
              'accessory-none': 0,
              'accessory-antenna': 20,
              'accessory-visor': 45,
              'accessory-headphones': 55,
              'accessory-crown': 90,
              'title-team': 0,
              'title-code': 20,
              'title-ideas': 30,
              'title-voice': 40,
              'title-teamwork': 60,
              'accessory-goggles': 45,
              'accessory-helmet': 65,
              'accessory-medal': 70,
              'room-base': 0,
              'room-orbit': 70,
              'room-neon': 80,
              'room-arena': 90,
              'bench-base': 0,
              'bench-engineer': 45,
              'bench-holo': 65,
              'bench-podium': 70,
              'light-base': 0,
              'light-neon': 30,
              'light-solar': 35,
              'light-cosmic': 40,
              'decor-base': 0,
              'decor-tools': 35,
              'decor-planet': 40,
              'decor-trophy': 60,
              'animation-default': 0,
              'animation-stage': 50,
              'animation-gears': 60,
              'animation-trophy': 80,
              'skin-bioglow': 55,
              'skin-ocean': 50,
              'skin-plasma': 95,
              'skin-graphite': 80,
              'frame-leaves': 50,
              'frame-circuit': 75,
              'accessory-leaf': 40,
              'accessory-scientist': 60,
              'accessory-pilot': 55,
              'title-bioglow': 35,
              'title-navigator': 45,
              'title-explorer': 30,
              'animation-fireflies': 85,
              'animation-rocket': 100}.get(id, -1);
    }
    function gearCategory(id) {
      return id.matches('skin-.*') ? 'skin' : id.matches('frame-.*') ? 'frame' : id.matches('accessory-.*') ? 'accessory' : id.matches('title-.*') ? 'title' : id.matches('room-.*') ? 'room' : id.matches('bench-.*') ? 'bench' : id.matches('light-.*') ? 'light' : id.matches('decor-.*') ? 'decor' : id.matches('animation-.*') ? 'animation' : '';
    }
    function gearEquipmentChange(data, before) {
      let category = gearCategory(data.lastAction.id);
      return gearPrice(data.lastAction.id) >= 0
        && (category == 'accessory' ? gearAccessoryChange(data, before, false)
          : data.equipped[category] == data.lastAction.id && data.equipped.diff(before.equipped).affectedKeys().hasOnly([category]));
    }
    function gearAccessories(equipped) {
      return equipped.get('accessories', equipped.get('accessory', 'accessory-none') == 'accessory-none' ? [] : [equipped.accessory]);
    }
    function validGearAccessories(equipped, owned) {
      let ids = gearAccessories(equipped);
      return ids is list && ids.size() <= 10 && ids.toSet().size() == ids.size()
        && ids.hasOnly(['accessory-antenna', 'accessory-visor', 'accessory-headphones', 'accessory-crown', 'accessory-goggles', 'accessory-helmet', 'accessory-medal', 'accessory-leaf', 'accessory-scientist', 'accessory-pilot'])
        && owned.hasAll(ids)
        && equipped.accessory == (ids.size() > 0 ? ids[ids.size() - 1] : 'accessory-none')
        && (equipped.keys().hasAny(['accessories']) ? ids.size() >= 2 : ids.size() <= 1);
    }
    function gearAccessoryChange(data, before, remove) {
      let ids = gearAccessories(before.equipped);
      let id = data.lastAction.id;
      let expected = id == 'accessory-none' ? []
        : (remove || (data.lastAction.type == 'equip' && id in ids)) ? ids.removeAll([id]) : ids.concat([id]);
      return gearAccessories(data.equipped) == expected
        && data.equipped.diff(before.equipped).affectedKeys().hasOnly(['accessory', 'accessories']);
    }
    function gearSameDaily(data, before) {
      return data.rewardDay == before.rewardDay && data.rewardDayIndex == before.rewardDayIndex
        && data.dayEarned == before.dayEarned && data.dayCounts == before.dayCounts;
    }
    function gearPoints(type) {
      return {'code': 12, 'expert': 20, 'contact': 8, 'robot': 12, 'attachment': 10, 'outreach': 15, 'logbook': 5, 'prototype': 15, 'test': 6, 'checkin': 5}[type];
    }
    function gearSameGrowth(data, before) {
      return data.growthPoints == before.get('growthPoints', 0)
        && data.contributionCounts == before.get('contributionCounts', {});
    }
    function gearGrowthChange(data, before, type) {
      let counts = before.get('contributionCounts', {});
      return data.growthPoints == before.get('growthPoints', 0) + gearPoints(type)
        && data.contributionCounts.diff(counts).affectedKeys().hasOnly([type])
        && data.contributionCounts[type] == counts.get(type, 0) + 1;
    }
    function gearReceiptValid(studentId, receiptId, receipt) {
      let config = {'code': ['codeSnippets', 'title', 12], 'expert': ['experts', 'name', 20],
        'contact': ['expertContacts', 'name', 8], 'robot': ['robotVersions', 'version', 12],
        'attachment': ['attachments', 'name', 10], 'outreach': ['outreach', 'name', 15],
        'logbook': ['logbook', 'text', 5], 'prototype': ['prototypeIterations', 'improvement', 15], 'test': ['score_history', 'date', 6], 'checkin': ['dailyMoods', 'date', 5]}[receipt.type];
      let collectionName = config[0];
      let source = receipt.type == 'logbook'
        ? get(/databases/$(database)/documents/students/$(studentId)/logbook/$(receipt.sourceId)).data
        : get(/databases/$(database)/documents/$(collectionName)/$(receipt.sourceId)).data;
      let amount = config[2];
      return receipt.keys().hasOnly(['studentId', 'type', 'sourceId', 'sourcePath', 'day', 'dayIndex', 'coins', 'growthPoints', 'createdAt'])
        && receipt.studentId == studentId && receipt.sourceId is string && receipt.sourceId.matches('[^/]+')
        && receiptId == studentId + '__' + receipt.type + '__' + (receipt.type == 'checkin' ? source.date : receipt.sourceId)
        && receipt.day is string && receipt.dayIndex == int((request.time.toMillis() - 10800000) / 86400000)
        && receipt.coins is int && receipt.coins == amount && receipt.coins >= 0
        && receipt.growthPoints == config[2]
        && receipt.sourcePath == (receipt.type == 'logbook' ? 'students/' + studentId + '/logbook/' + receipt.sourceId : collectionName + '/' + receipt.sourceId)
        && source.get('createdByStudentId', source.get('studentId', '')) == studentId
        && source.get(config[1], '') is string && source.get(config[1], '').size() > 0
        && (receipt.type != 'checkin' || (source.level in [25, 50, 75, 100] && source.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }
    function gearRewardChange(studentId, data, before) {
      let receiptId = data.lastAction.id;
      let receipt = getAfter(/databases/$(database)/documents/studentGearRewards/$(receiptId)).data;
      let sameDay = before.rewardDayIndex == receipt.dayIndex;
      let counts = sameDay ? before.dayCounts : {};
      return !exists(/databases/$(database)/documents/studentGearRewards/$(receiptId))
        && gearReceiptValid(studentId, receiptId, receipt)
        && data.lastAction.coins == receipt.coins && data.balance == before.balance + receipt.coins
        && data.earned == before.earned + receipt.coins && data.spent == before.spent
        && gearGrowthChange(data, before, receipt.type)
        && data.owned == before.owned && data.equipped == before.equipped
        && data.rewardDay == receipt.day && data.rewardDayIndex == receipt.dayIndex
        && data.dayEarned == (sameDay ? before.dayEarned : 0) + receipt.coins
        && data.dayCounts.diff(counts).affectedKeys().hasOnly([receipt.type])
        && data.dayCounts[receipt.type] == counts.get(receipt.type, 0) + 1;
    }
    // Historical recognition is a technician operation; students cannot claim a
    // legacy author name themselves.
    function gearHistorySourceValid(studentId, receiptId, receipt) {
      let config = {'code': ['codeSnippets', 'title'], 'expert': ['experts', 'name'], 'contact': ['expertContacts', 'name'],
        'robot': ['robotVersions', 'version'], 'attachment': ['attachments', 'name'], 'outreach': ['outreach', 'name'],
        'logbook': ['logbook', 'text'], 'prototype': ['prototypeIterations', 'improvement'], 'test': ['score_history', 'date'], 'checkin': ['dailyMoods', 'date']}[receipt.type];
      let source = receipt.type == 'logbook'
        ? get(/databases/$(database)/documents/students/$(studentId)/logbook/$(receipt.sourceId)).data
        : get(/databases/$(database)/documents/$(config[0])/$(receipt.sourceId)).data;
      return isReportAdmin() && receipt.studentId == studentId
        && receiptId == studentId + '__' + receipt.type + '__' + (receipt.type == 'checkin' ? source.date : receipt.sourceId)
        && receipt.sourceId is string && receipt.sourceId.matches('[^/]+')
        && receipt.sourcePath == (receipt.type == 'logbook' ? 'students/' + studentId + '/logbook/' + receipt.sourceId : config[0] + '/' + receipt.sourceId)
        && receipt.growthPoints == gearPoints(receipt.type)
        && source.get(config[1], '') is string && source.get(config[1], '').size() > 0
        && get(/databases/$(database)/documents/students/$(studentId)).data.get('status', 'active') != 'inactive';
    }
    function gearHistoryChange(studentId, data, before) {
      let receiptId = data.lastAction.id;
      let receiptPath = /databases/$(database)/documents/studentGearRewards/$(receiptId);
      let receipt = getAfter(receiptPath).data;
      let previous = exists(receiptPath) ? get(receiptPath).data : {};
      let coins = gearPoints(receipt.type) - previous.get('coins', 0);
      return gearHistorySourceValid(studentId, receiptId, receipt)
        && (!('growthPoints' in previous) || coins > 0)
        && coins >= 0 && receipt.coins == gearPoints(receipt.type)
        && (exists(receiptPath) || receipt.mode == 'history')
        && data.lastAction.coins == coins && data.balance == before.balance + coins
        && data.earned == before.earned + coins && data.spent == before.spent
        && data.owned == before.owned && data.equipped == before.equipped
        && gearSameDaily(data, before)
        && ('growthPoints' in previous ? gearSameGrowth(data, before) : gearGrowthChange(data, before, receipt.type));
    }
    function gearRefundReceiptId(studentId, count) {
      return studentId + '__' + (count == 1 ? '1' : count == 2 ? '2' : '3');
    }
    function gearInitialEquipment() {
      return {'skin': 'skin-nebula', 'frame': 'frame-none', 'accessory': 'accessory-none', 'title': 'title-team', 'room': 'room-base', 'bench': 'bench-base', 'light': 'light-base', 'decor': 'decor-base', 'animation': 'animation-default'};
    }
    function gearRefundChange(studentId, data, before) {
      let itemId = data.lastAction.id;
      let price = gearPrice(itemId);
      let category = gearCategory(itemId);
      let receiptId = gearRefundReceiptId(studentId, data.refundCount);
      let receipt = getAfter(/databases/$(database)/documents/studentGearRefunds/$(receiptId)).data;
      return before.refundCount < 3 && itemId in before.owned && itemId in before.refundableItems && price > 0
        && data.lastAction.coins == price && data.balance == before.balance + price && data.spent == before.spent - price && data.earned == before.earned
        && data.owned == before.owned.removeAll([itemId]) && data.refundableItems == before.refundableItems.removeAll([itemId])
        && (category == 'accessory' ? gearAccessoryChange(data, before, true)
          : data.equipped[category] == (before.equipped[category] == itemId ? gearInitialEquipment()[category] : before.equipped[category])
            && data.equipped.diff(before.equipped).affectedKeys().hasOnly([category]))
        && gearSameDaily(data, before) && gearSameGrowth(data, before)
        && !exists(/databases/$(database)/documents/studentGearRefunds/$(receiptId))
        && receipt.studentId == studentId && receipt.itemId == itemId && receipt.number == data.refundCount && receipt.coins == price;
    }
    function gearPurchaseResetChange(studentId, data, before) {
      let receiptId = 'v1__' + studentId;
      let receipt = getAfter(/databases/$(database)/documents/gearPurchaseResets/$(receiptId)).data;
      return isReportAdmin() && before.spent > 0 && data.lastAction.id == receiptId && data.lastAction.coins == before.spent
        && data.balance == before.balance + before.spent && data.spent == 0 && data.earned == before.earned
        && data.refundableItems == [] && gearSameDaily(data, before) && gearSameGrowth(data, before)
        && !exists(/databases/$(database)/documents/gearPurchaseResets/$(receiptId))
        && receipt.studentId == studentId && receipt.coins == before.spent
        && (receipt.keepItems ? data.owned == before.owned && data.equipped == before.equipped
          : data.owned.size() == 9 && data.owned.toSet() == gearInitialEquipment().values().toSet() && data.equipped == gearInitialEquipment());
    }
    function validGearGrantReceipt(studentId, grantId, receipt) {
      return isReportAdmin()
        && receipt.keys().hasOnly(['studentId', 'coins', 'reason', 'grantId', 'seasonId', 'actorId', 'actorName', 'createdAt'])
        && receipt.studentId == studentId && receipt.grantId == grantId
        && receipt.coins is int && receipt.coins >= 1 && receipt.coins <= 10000
        && receipt.reason is string && receipt.reason.size() >= 3 && receipt.reason.size() <= 500
        && receipt.actorId == request.auth.uid && receipt.actorName is string && receipt.actorName.size() <= 120
        && receipt.createdAt is string && receipt.seasonId is string && giroSeasonWritable(receipt.seasonId)
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.get('status', 'active') != 'inactive';
    }
    function gearManualGrantChange(studentId, data, before) {
      let grantId = data.lastAction.id;
      let receipt = getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)/manualGrants/$(grantId)).data;
      return validGearGrantReceipt(studentId, grantId, receipt)
        && !exists(/databases/$(database)/documents/studentGearProfiles/$(studentId)/manualGrants/$(grantId))
        && data.lastAction.coins == receipt.coins
        && data.balance == before.balance + receipt.coins && data.earned == before.earned + receipt.coins
        && data.spent == before.spent && data.owned == before.owned && data.equipped == before.equipped
        && gearSameDaily(data, before) && gearSameGrowth(data, before);
    }
    function validTaskGearCreate(data) {
      return data.get('gearReward', 0) is int && data.get('gearReward', 0) >= 0 && data.get('gearReward', 0) <= 10000
        && (isReportAdmin() || data.get('gearReward', 0) == 0)
        && !data.keys().hasAny(['gearRewardPaidAt', 'gearRewardPaidStudentIds', 'gearRewardPaidBy']);
    }
    function validTaskGearUpdate(data, before) {
      return data.get('gearReward', 0) is int && data.get('gearReward', 0) >= 0 && data.get('gearReward', 0) <= 10000
        && (isReportAdmin() || !data.diff(before).affectedKeys().hasAny(['gearReward', 'gearRewardUpdatedBy', 'gearRewardPaidAt', 'gearRewardPaidStudentIds', 'gearRewardPaidBy']))
        && (before.get('gearRewardPaidAt', '') == '' || !data.diff(before).affectedKeys().hasAny(['gearReward', 'gearRewardPaidAt', 'gearRewardPaidStudentIds', 'gearRewardPaidBy']));
    }
    function gearTaskGrantChange(studentId, data, before) {
      let taskId = data.lastAction.id;
      let previous = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      let task = getAfter(/databases/$(database)/documents/tasks/$(taskId)).data;
      let receipt = getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)/taskGrants/$(taskId)).data;
      let people = previous.get('participants', []);
      return isReportAdmin() && previous.status == 'review' && task.status == 'done' && previous.get('gearRewardPaidAt', '') == ''
        && previous.gearReward is int && previous.gearReward >= 1 && previous.gearReward <= 10000 && task.gearReward == previous.gearReward
        && task.gearRewardPaidAt == receipt.createdAt && task.gearRewardPaidBy == request.auth.uid
        && task.gearRewardPaidStudentIds is list && task.gearRewardPaidStudentIds.size() <= 3 && studentId in task.gearRewardPaidStudentIds
        && ((people.size() > 0 && people[0].id == studentId) || (people.size() > 1 && people[1].id == studentId) || (people.size() > 2 && people[2].id == studentId) || (people.size() == 0 && previous.get('assigneeId', '') == studentId))
        && receipt.keys().hasOnly(['studentId', 'taskId', 'seasonId', 'coins', 'reason', 'actorId', 'actorName', 'createdAt'])
        && receipt.studentId == studentId && receipt.taskId == taskId && receipt.coins == task.gearReward && receipt.actorId == request.auth.uid
        && receipt.reason is string && receipt.reason.size() >= 3 && receipt.reason.size() <= 500
        && receipt.actorName is string && receipt.actorName.size() <= 120 && receipt.createdAt is string
        && receipt.seasonId is string && previous.get('seasonId', receipt.seasonId) == receipt.seasonId && giroSeasonWritable(receipt.seasonId)
        && get(/databases/$(database)/documents/students/$(studentId)).data.get('status', 'active') != 'inactive'
        && !exists(/databases/$(database)/documents/studentGearProfiles/$(studentId)/taskGrants/$(taskId))
        && data.lastAction.coins == receipt.coins && data.balance == before.balance + receipt.coins && data.earned == before.earned + receipt.coins
        && data.spent == before.spent && data.owned == before.owned && data.equipped == before.equipped && gearSameDaily(data, before) && gearSameGrowth(data, before);
    }
    function validGearProfile(studentId) {
      let data = request.resource.data;
      let before = gearBefore(studentId);
      let price = gearPrice(data.lastAction.id);
      return data.keys().hasOnly(['studentId', 'balance', 'earned', 'spent', 'owned', 'equipped', 'rewardDay', 'rewardDayIndex', 'dayEarned', 'dayCounts', 'growthPoints', 'contributionCounts', 'updatedAt', 'lastAction', 'refundCount', 'refundableItems'])
        && data.studentId == studentId && data.balance is int && data.balance >= 0
        && data.earned is int && data.spent is int && data.spent >= 0 && data.earned == data.balance + data.spent
        && data.growthPoints is int && data.growthPoints >= 0 && data.contributionCounts is map
        && data.refundCount is int && data.refundCount >= 0 && data.refundCount <= 3
        && data.refundableItems is list && data.refundableItems.size() <= 58 && data.refundableItems.toSet().size() == data.refundableItems.size()
        && data.owned.hasAll(data.refundableItems)
        && (data.lastAction.type == 'refund' ? data.refundCount == before.refundCount + 1 : data.refundCount == before.refundCount)
        && (data.lastAction.type in ['purchase', 'refund', 'purchase_reset'] || data.refundableItems == before.refundableItems)
        && data.owned is list && data.owned.size() <= 58
        && data.equipped.keys().hasOnly(['skin', 'frame', 'accessory', 'accessories', 'title', 'room', 'bench', 'light', 'decor', 'animation'])
        && validGearAccessories(data.equipped, data.owned)
        && data.owned.hasAll([data.equipped.skin, data.equipped.frame, data.equipped.accessory, data.equipped.title, data.equipped.room, data.equipped.bench, data.equipped.light, data.equipped.decor, data.equipped.animation])
        && gearCategory(data.equipped.skin) == 'skin' && gearCategory(data.equipped.frame) == 'frame' && gearCategory(data.equipped.accessory) == 'accessory' && gearCategory(data.equipped.title) == 'title' && gearCategory(data.equipped.room) == 'room' && gearCategory(data.equipped.bench) == 'bench' && gearCategory(data.equipped.light) == 'light' && gearCategory(data.equipped.decor) == 'decor' && gearCategory(data.equipped.animation) == 'animation'
        && data.lastAction.keys().hasOnly(['type', 'id', 'coins'])
        && ((data.lastAction.type == 'purchase' && price > 0 && !(data.lastAction.id in before.owned)
              && data.refundableItems == before.refundableItems.concat([data.lastAction.id])
              && data.lastAction.coins == price && data.balance == before.balance - price && data.spent == before.spent + price
              && data.earned == before.earned && data.owned == before.owned.concat([data.lastAction.id])
              && gearEquipmentChange(data, before) && gearSameDaily(data, before) && gearSameGrowth(data, before))
          || (data.lastAction.type == 'equip' && data.lastAction.id in before.owned && data.lastAction.coins == 0
              && data.balance == before.balance && data.earned == before.earned && data.spent == before.spent
              && data.owned == before.owned && gearEquipmentChange(data, before) && gearSameDaily(data, before) && gearSameGrowth(data, before))
          || (data.lastAction.type == 'reward' && gearRewardChange(studentId, data, before))
          || (data.lastAction.type == 'history' && gearHistoryChange(studentId, data, before))
          || (data.lastAction.type == 'refund' && gearRefundChange(studentId, data, before))
          || (data.lastAction.type == 'purchase_reset' && gearPurchaseResetChange(studentId, data, before))
          || (data.lastAction.type == 'manual_grant' && gearManualGrantChange(studentId, data, before))
          || (data.lastAction.type == 'task_grant' && gearTaskGrantChange(studentId, data, before)));
    }
    match /studentGearProfiles/{studentId} {
      allow read: if isGearOwner(studentId) || isReportAdmin();
      allow create, update: if (isGearOwner(studentId) || (isReportAdmin() && request.resource.data.lastAction.type in ['history', 'purchase_reset', 'manual_grant', 'task_grant'])) && validGearProfile(studentId);
      allow delete: if false;
    }
    match /studentGearProfiles/{studentId}/manualGrants/{grantId} {
      allow read: if isReportAdmin() || isGearOwner(studentId);
      allow create: if validGearGrantReceipt(studentId, grantId, request.resource.data)
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data.lastAction.type == 'manual_grant'
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data.lastAction.id == grantId
        && gearManualGrantChange(studentId, getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data, gearBefore(studentId));
      allow update, delete: if false;
    }
    match /studentGearProfiles/{studentId}/taskGrants/{taskId} {
      allow read: if isReportAdmin() || isGearOwner(studentId);
      allow create: if isReportAdmin()
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data.lastAction.type == 'task_grant'
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data.lastAction.id == taskId
        && gearTaskGrantChange(studentId, getAfter(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data, gearBefore(studentId));
      allow update, delete: if false;
    }
    match /studentGearRefunds/{receiptId} {
      allow get: if isReportAdmin() || (isReportMember() && (!exists(/databases/$(database)/documents/studentGearRefunds/$(receiptId)) || isGearOwner(resource.data.studentId)));
      allow list: if isReportAdmin() || isGearOwner(resource.data.studentId);
      allow create: if isGearOwner(request.resource.data.studentId)
        && request.resource.data.keys().hasOnly(['studentId', 'itemId', 'coins', 'number', 'createdAt'])
        && request.resource.data.number in [1, 2, 3]
        && receiptId == gearRefundReceiptId(request.resource.data.studentId, request.resource.data.number)
        && request.resource.data.createdAt is string
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.lastAction.type == 'refund'
        && gearRefundChange(request.resource.data.studentId, getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data, gearBefore(request.resource.data.studentId));
      allow update, delete: if false;
    }
    match /gearPurchaseResets/{receiptId} {
      allow read: if isReportAdmin();
      allow create: if isReportAdmin()
        && request.resource.data.keys().hasOnly(['studentId', 'coins', 'keepItems', 'previousOwned', 'previousEquipped', 'createdAt'])
        && request.resource.data.keepItems is bool && request.resource.data.createdAt is string
        && receiptId == 'v1__' + request.resource.data.studentId
        && request.resource.data.previousOwned == gearBefore(request.resource.data.studentId).owned
        && request.resource.data.previousEquipped == gearBefore(request.resource.data.studentId).equipped
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.lastAction.type == 'purchase_reset'
        && gearPurchaseResetChange(request.resource.data.studentId, getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data, gearBefore(request.resource.data.studentId));
      allow update, delete: if false;
    }
    match /studentGearRewards/{receiptId} {
      allow get: if isReportAdmin() || (isReportMember()
        && (!exists(/databases/$(database)/documents/studentGearRewards/$(receiptId)) || isGearOwner(resource.data.studentId)));
      allow list: if isGearOwner(resource.data.studentId) || isReportAdmin();
      allow create: if ((isGearOwner(request.resource.data.studentId)
        && gearReceiptValid(request.resource.data.studentId, receiptId, request.resource.data)
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.lastAction.type == 'reward')
        || (gearHistorySourceValid(request.resource.data.studentId, receiptId, request.resource.data)
        && request.resource.data.keys().hasOnly(['studentId', 'type', 'sourceId', 'sourcePath', 'day', 'dayIndex', 'coins', 'growthPoints', 'mode', 'attribution', 'createdAt'])
        && request.resource.data.mode == 'history' && request.resource.data.coins == gearPoints(request.resource.data.type)
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.lastAction.type == 'history'))
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.lastAction.id == receiptId
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.balance == gearBefore(request.resource.data.studentId).balance + request.resource.data.coins;
      allow update: if isReportAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'growthPoints', 'evolutionMigratedAt', 'coinsBeforeUncap', 'uncappedAt'])
        && resource.data.coins <= gearPoints(resource.data.type)
        && request.resource.data.coins == gearPoints(resource.data.type)
        && (resource.data.coins == request.resource.data.coins || (request.resource.data.coinsBeforeUncap == resource.data.coins && request.resource.data.uncappedAt is string))
        && gearHistorySourceValid(resource.data.studentId, receiptId, request.resource.data)
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(resource.data.studentId)).data.lastAction.type == 'history'
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(resource.data.studentId)).data.lastAction.id == receiptId
        && gearHistoryChange(resource.data.studentId, getAfter(/databases/$(database)/documents/studentGearProfiles/$(resource.data.studentId)).data, gearBefore(resource.data.studentId));
      allow delete: if false;
    }
    match /gearHistoryMigrations/{migrationId} {
      allow read, write: if isReportAdmin();
    }
    match /weeklyReports/{reportId} {
      allow read: if isReportMember();
      // Todas as alterações passam pela API, que verifica autor/admin e conteúdo do arquivo.
      allow write: if false;
    }
    match /weeklyReportReads/{uid}/reports/{reportId} {
      allow read: if isReportMember() && request.auth.uid == uid;
      allow write: if false;
    }
    match /weeklyReportRecipients/{recipientId} {
      allow read: if isReportAdmin();
      allow write: if false;
    }
    match /weeklyReportEmailJobs/{jobId} {
      allow read, write: if false;
    }
    match /weeklyReportCleanup/{cleanupId} {
      allow read, write: if false;
    }
    match /weeklyReportExpectations/{periodId} {
      allow read, write: if false;
    }
    match /automaticReminderJobs/{jobId} {
      allow read, write: if false;
    }
    match /settings/automatic_reminders {
      allow read, write: if false;
    }
    match /settings/reminder_scheduler {
      allow read, write: if false;
    }
  }
}
