// Integrar estes blocos às regras existentes; este arquivo sozinho não libera as outras abas.
// Uma regra global "allow read, write: if true" deve EXCLUIR estas coleções.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function reportStudentIsActive(member) {
      return member.role == 'admin'
        || !exists(/databases/$(database)/documents/students/$(member.studentId))
        || get(/databases/$(database)/documents/students/$(member.studentId)).data.get('status', 'active') != 'inactive';
    }
    function isReportMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.role in ['admin', 'student']
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.email.lower() == request.auth.token.email.lower()
        && reportStudentIsActive(get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data);
    }
    function isReportAdmin() {
      return isReportMember()
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.role == 'admin';
    }
    // Biblioteca do Giro: a equipe lê somente publicados; técnicos gerenciam os materiais.
    function validGiroMaterial(data) {
      return data.keys().hasOnly(['title', 'category', 'status', 'tags', 'sourceURL', 'pages', 'textLength', 'fileName', 'version', 'seasonId', 'createdAt', 'updatedAt', 'revision'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 180
        && data.category in ['rubric', 'tournament', 'season', 'robot', 'project', 'general']
        && data.status in ['draft', 'published', 'archived']
        && data.tags is string && data.tags.size() <= 500
        && data.sourceURL is string && data.sourceURL.size() <= 2000
        && (data.sourceURL == '' || data.sourceURL.matches('https?://.*'))
        && data.pages is list && data.pages.size() >= 1 && data.pages.size() <= 200
        && data.textLength is int && data.textLength >= 20 && data.textLength <= 120000
        && data.fileName is string && data.fileName.size() <= 220 && data.version == 1
        && data.seasonId is string && data.createdAt is string && data.updatedAt is string
        && data.revision is int && data.revision >= 1;
    }
    function giroSeasonWritable(seasonId) {
      let settings = exists(/databases/$(database)/documents/settings/workspace_season)
        ? get(/databases/$(database)/documents/settings/workspace_season).data : {};
      return settings.get('activeSeasonId', 'legacy') == seasonId && settings.get('transitionLock', null) == null;
    }
    match /giroKnowledgeMaterials/{materialId} {
      allow read: if isReportAdmin() || (isReportMember() && resource.data.status == 'published');
      allow create: if isReportAdmin() && validGiroMaterial(request.resource.data)
        && request.resource.data.revision == 1 && giroSeasonWritable(request.resource.data.seasonId);
      allow update: if isReportAdmin() && validGiroMaterial(request.resource.data)
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && giroSeasonWritable(resource.data.seasonId);
      allow delete: if false;
    }
    match /weeklyReportMembers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Contador do Giro IA: somente o servidor pode reservar o uso da API.
    match /giroAiUsage/{uid} {
      allow read, write: if false;
    }
    match /finalSprintTournamentDrafts/{seasonId} {
      allow read, write: if isReportAdmin();
    }
    // Giro: carteira privada, catálogo fixo e recibos únicos por contribuição.
    function isGearOwner(studentId) {
      return isReportMember()
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.role == 'student'
        && get(/databases/$(database)/documents/weeklyReportMembers/$(request.auth.uid)).data.studentId == studentId;
    }
    function validWorkshopPoint(point, minX, maxX, minY, maxY) {
      return point is map && point.keys().hasOnly(['x', 'y']) && point.x is int && point.y is int
        && point.x >= minX && point.x <= maxX && point.y >= minY && point.y <= maxY;
    }
    function validGearWorkshop(data) {
      return data is map && data.keys().hasOnly(['layout', 'expression', 'updatedAt'])
        && data.expression in ['auto', 'happy', 'curious', 'focused', 'surprised']
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && data.layout is map && data.layout.keys().hasOnly(['bench', 'decor', 'giro', 'light'])
        && validWorkshopPoint(data.layout.bench, 120, 680, 250, 360)
        && validWorkshopPoint(data.layout.decor, 100, 700, 190, 320)
        && validWorkshopPoint(data.layout.giro, 135, 665, 275, 350)
        && validWorkshopPoint(data.layout.light, 230, 570, 34, 85);
    }
    // Merge this narrow update with the existing student permissions.
    match /students/{studentId} {
      allow update: if isGearOwner(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gearWorkshop'])
        && validGearWorkshop(request.resource.data.gearWorkshop);
      match /gearWorkshopReactions/{actorId} {
        allow read: if isReportMember();
        allow create, update: if isGearOwner(actorId) && studentId != actorId
          && exists(/databases/$(database)/documents/students/$(studentId))
          && get(/databases/$(database)/documents/students/$(studentId)).data.get('status', 'active') != 'inactive'
          && request.resource.data.keys().hasOnly(['actorStudentId', 'targetStudentId', 'type', 'updatedAt'])
          && request.resource.data.actorStudentId == actorId && request.resource.data.targetStudentId == studentId
          && request.resource.data.type in ['creative', 'style', 'inspiring', 'none']
          && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
        allow delete: if false;
      }
    }
    function gearBefore(studentId) {
      let previous = exists(/databases/$(database)/documents/studentGearProfiles/$(studentId))
        ? get(/databases/$(database)/documents/studentGearProfiles/$(studentId)).data : {};
      let equipped = previous.get('equipped', {});
      let defaults = ['skin-nebula', 'frame-none', 'accessory-none', 'title-team', 'room-base', 'bench-base', 'light-base', 'decor-base', 'animation-default'];
      // Normalize older wallets without charging for the starter workshop.
      return {'balance': previous.get('balance', 40), 'earned': previous.get('earned', 40), 'spent': previous.get('spent', 0),
           'owned': defaults.concat(previous.get('owned', []).removeAll(defaults)),
           'equipped': {'skin': equipped.get('skin', 'skin-nebula'),
             'frame': equipped.get('frame', 'frame-none'),
             'accessory': equipped.get('accessory', 'accessory-none'),
             'title': equipped.get('title', 'title-team'),
             'room': equipped.get('room', 'room-base'),
             'bench': equipped.get('bench', 'bench-base'),
             'light': equipped.get('light', 'light-base'),
             'decor': equipped.get('decor', 'decor-base'),
             'animation': equipped.get('animation', 'animation-default')},
           'rewardDay': previous.get('rewardDay', ''), 'rewardDayIndex': previous.get('rewardDayIndex', -1),
           'dayEarned': previous.get('dayEarned', 0), 'dayCounts': previous.get('dayCounts', {}),
           'growthPoints': previous.get('growthPoints', 0), 'contributionCounts': previous.get('contributionCounts', {})};
    }
    function gearPrice(id) {
      return {'skin-nebula': 0,
              'skin-solar': 25,
              'skin-emerald': 35,
              'skin-rose': 45,
              'skin-arctic': 65,
              'skin-lava': 85,
              'frame-none': 0,
              'frame-orbit': 20,
              'frame-hex': 40,
              'frame-stars': 60,
              'frame-champion': 100,
              'accessory-none': 0,
              'accessory-antenna': 20,
              'accessory-visor': 45,
              'accessory-headphones': 55,
              'accessory-crown': 90,
              'title-team': 0,
              'title-code': 20,
              'title-ideas': 30,
              'title-voice': 40,
              'title-teamwork': 60,
              'accessory-goggles': 45,
              'accessory-helmet': 65,
              'accessory-medal': 70,
              'room-base': 0,
              'room-orbit': 70,
              'room-neon': 80,
              'room-arena': 90,
              'bench-base': 0,
              'bench-engineer': 45,
              'bench-holo': 65,
              'bench-podium': 70,
              'light-base': 0,
              'light-neon': 30,
              'light-solar': 35,
              'light-cosmic': 40,
              'decor-base': 0,
              'decor-tools': 35,
              'decor-planet': 40,
              'decor-trophy': 60,
              'animation-default': 0,
              'animation-stage': 50,
              'animation-gears': 60,
              'animation-trophy': 80}.get(id, -1);
    }
    function gearCategory(id) {
      return id.matches('skin-.*') ? 'skin' : id.matches('frame-.*') ? 'frame' : id.matches('accessory-.*') ? 'accessory' : id.matches('title-.*') ? 'title' : id.matches('room-.*') ? 'room' : id.matches('bench-.*') ? 'bench' : id.matches('light-.*') ? 'light' : id.matches('decor-.*') ? 'decor' : id.matches('animation-.*') ? 'animation' : '';
    }
    function gearEquipmentChange(data, before) {
      let category = gearCategory(data.lastAction.id);
      return gearPrice(data.lastAction.id) >= 0 && data.equipped[category] == data.lastAction.id
        && data.equipped.diff(before.equipped).affectedKeys().hasOnly([category]);
    }
    function gearSameDaily(data, before) {
      return data.rewardDay == before.rewardDay && data.rewardDayIndex == before.rewardDayIndex
        && data.dayEarned == before.dayEarned && data.dayCounts == before.dayCounts;
    }
    function gearPoints(type) {
      return {'code': 12, 'expert': 20, 'contact': 8, 'robot': 12, 'attachment': 10, 'outreach': 15, 'logbook': 5, 'prototype': 15, 'test': 6, 'checkin': 5}[type];
    }
    function gearSameGrowth(data, before) {
      return data.growthPoints == before.get('growthPoints', 0)
        && data.contributionCounts == before.get('contributionCounts', {});
    }
    function gearGrowthChange(data, before, type) {
      let counts = before.get('contributionCounts', {});
      return data.growthPoints == before.get('growthPoints', 0) + gearPoints(type)
        && data.contributionCounts.diff(counts).affectedKeys().hasOnly([type])
        && data.contributionCounts[type] == counts.get(type, 0) + 1;
    }
    function gearReceiptValid(studentId, receiptId, receipt) {
      let config = {'code': ['codeSnippets', 'title', 12], 'expert': ['experts', 'name', 20],
        'contact': ['expertContacts', 'name', 8], 'robot': ['robotVersions', 'version', 12],
        'attachment': ['attachments', 'name', 10], 'outreach': ['outreach', 'name', 15],
        'logbook': ['logbook', 'text', 5], 'prototype': ['prototypeIterations', 'improvement', 15], 'test': ['score_history', 'date', 6], 'checkin': ['dailyMoods', 'date', 5]}[receipt.type];
      let collectionName = config[0];
      let source = receipt.type == 'logbook'
        ? get(/databases/$(database)/documents/students/$(studentId)/logbook/$(receipt.sourceId)).data
        : get(/databases/$(database)/documents/$(collectionName)/$(receipt.sourceId)).data;
      let amount = config[2];
      return receipt.keys().hasOnly(['studentId', 'type', 'sourceId', 'sourcePath', 'day', 'dayIndex', 'coins', 'growthPoints', 'createdAt'])
        && receipt.studentId == studentId && receipt.sourceId is string && receipt.sourceId.matches('[^/]+')
        && receiptId == studentId + '__' + receipt.type + '__' + (receipt.type == 'checkin' ? source.date : receipt.sourceId)
        && receipt.day is string && receipt.dayIndex == int((request.time.toMillis() - 10800000) / 86400000)
        && receipt.coins is int && receipt.coins == amount && receipt.coins >= 0
        && receipt.growthPoints == config[2]
        && receipt.sourcePath == (receipt.type == 'logbook' ? 'students/' + studentId + '/logbook/' + receipt.sourceId : collectionName + '/' + receipt.sourceId)
        && source.get('createdByStudentId', source.get('studentId', '')) == studentId
        && source.get(config[1], '') is string && source.get(config[1], '').size() > 0
        && (receipt.type != 'checkin' || (source.level in [25, 50, 75, 100] && source.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }
    function gearRewardChange(studentId, data, before) {
      let receiptId = data.lastAction.id;
      let receipt = getAfter(/databases/$(database)/documents/studentGearRewards/$(receiptId)).data;
      let sameDay = before.rewardDayIndex == receipt.dayIndex;
      let counts = sameDay ? before.dayCounts : {};
      return !exists(/databases/$(database)/documents/studentGearRewards/$(receiptId))
        && gearReceiptValid(studentId, receiptId, receipt)
        && data.lastAction.coins == receipt.coins && data.balance == before.balance + receipt.coins
        && data.earned == before.earned + receipt.coins && data.spent == before.spent
        && gearGrowthChange(data, before, receipt.type)
        && data.owned == before.owned && data.equipped == before.equipped
        && data.rewardDay == receipt.day && data.rewardDayIndex == receipt.dayIndex
        && data.dayEarned == (sameDay ? before.dayEarned : 0) + receipt.coins
        && data.dayCounts.diff(counts).affectedKeys().hasOnly([receipt.type])
        && data.dayCounts[receipt.type] == counts.get(receipt.type, 0) + 1;
    }
    // Historical recognition is a technician operation; students cannot claim a
    // legacy author name themselves.
    function gearHistorySourceValid(studentId, receiptId, receipt) {
      let config = {'code': ['codeSnippets', 'title'], 'expert': ['experts', 'name'], 'contact': ['expertContacts', 'name'],
        'robot': ['robotVersions', 'version'], 'attachment': ['attachments', 'name'], 'outreach': ['outreach', 'name'],
        'logbook': ['logbook', 'text'], 'prototype': ['prototypeIterations', 'improvement'], 'test': ['score_history', 'date'], 'checkin': ['dailyMoods', 'date']}[receipt.type];
      let source = receipt.type == 'logbook'
        ? get(/databases/$(database)/documents/students/$(studentId)/logbook/$(receipt.sourceId)).data
        : get(/databases/$(database)/documents/$(config[0])/$(receipt.sourceId)).data;
      return isReportAdmin() && receipt.studentId == studentId
        && receiptId == studentId + '__' + receipt.type + '__' + (receipt.type == 'checkin' ? source.date : receipt.sourceId)
        && receipt.sourceId is string && receipt.sourceId.matches('[^/]+')
        && receipt.sourcePath == (receipt.type == 'logbook' ? 'students/' + studentId + '/logbook/' + receipt.sourceId : config[0] + '/' + receipt.sourceId)
        && receipt.growthPoints == gearPoints(receipt.type)
        && source.get(config[1], '') is string && source.get(config[1], '').size() > 0
        && get(/databases/$(database)/documents/students/$(studentId)).data.get('status', 'active') != 'inactive';
    }
    function gearHistoryChange(studentId, data, before) {
      let receiptId = data.lastAction.id;
      let receiptPath = /databases/$(database)/documents/studentGearRewards/$(receiptId);
      let receipt = getAfter(receiptPath).data;
      let previous = exists(receiptPath) ? get(receiptPath).data : {};
      let coins = gearPoints(receipt.type) - previous.get('coins', 0);
      return gearHistorySourceValid(studentId, receiptId, receipt)
        && (!('growthPoints' in previous) || coins > 0)
        && coins >= 0 && receipt.coins == gearPoints(receipt.type)
        && (exists(receiptPath) || receipt.mode == 'history')
        && data.lastAction.coins == coins && data.balance == before.balance + coins
        && data.earned == before.earned + coins && data.spent == before.spent
        && data.owned == before.owned && data.equipped == before.equipped
        && gearSameDaily(data, before)
        && ('growthPoints' in previous ? gearSameGrowth(data, before) : gearGrowthChange(data, before, receipt.type));
    }
    function validGearProfile(studentId) {
      let data = request.resource.data;
      let before = gearBefore(studentId);
      let price = gearPrice(data.lastAction.id);
      return data.keys().hasOnly(['studentId', 'balance', 'earned', 'spent', 'owned', 'equipped', 'rewardDay', 'rewardDayIndex', 'dayEarned', 'dayCounts', 'growthPoints', 'contributionCounts', 'updatedAt', 'lastAction'])
        && data.studentId == studentId && data.balance is int && data.balance >= 0
        && data.earned is int && data.spent is int && data.spent >= 0 && data.earned == data.balance + data.spent
        && data.growthPoints is int && data.growthPoints >= 0 && data.contributionCounts is map
        && data.owned is list && data.owned.size() <= 44
        && data.equipped.keys().hasOnly(['skin', 'frame', 'accessory', 'title', 'room', 'bench', 'light', 'decor', 'animation'])
        && data.owned.hasAll([data.equipped.skin, data.equipped.frame, data.equipped.accessory, data.equipped.title, data.equipped.room, data.equipped.bench, data.equipped.light, data.equipped.decor, data.equipped.animation])
        && gearCategory(data.equipped.skin) == 'skin' && gearCategory(data.equipped.frame) == 'frame' && gearCategory(data.equipped.accessory) == 'accessory' && gearCategory(data.equipped.title) == 'title' && gearCategory(data.equipped.room) == 'room' && gearCategory(data.equipped.bench) == 'bench' && gearCategory(data.equipped.light) == 'light' && gearCategory(data.equipped.decor) == 'decor' && gearCategory(data.equipped.animation) == 'animation'
        && data.lastAction.keys().hasOnly(['type', 'id', 'coins'])
        && ((data.lastAction.type == 'purchase' && price > 0 && !(data.lastAction.id in before.owned)
              && data.lastAction.coins == price && data.balance == before.balance - price && data.spent == before.spent + price
              && data.earned == before.earned && data.owned == before.owned.concat([data.lastAction.id])
              && gearEquipmentChange(data, before) && gearSameDaily(data, before) && gearSameGrowth(data, before))
          || (data.lastAction.type == 'equip' && data.lastAction.id in before.owned && data.lastAction.coins == 0
              && data.balance == before.balance && data.earned == before.earned && data.spent == before.spent
              && data.owned == before.owned && gearEquipmentChange(data, before) && gearSameDaily(data, before) && gearSameGrowth(data, before))
          || (data.lastAction.type == 'reward' && gearRewardChange(studentId, data, before))
          || (data.lastAction.type == 'history' && gearHistoryChange(studentId, data, before)));
    }
    match /studentGearProfiles/{studentId} {
      allow read: if isGearOwner(studentId) || isReportAdmin();
      allow create, update: if (isGearOwner(studentId) || (isReportAdmin() && request.resource.data.lastAction.type == 'history')) && validGearProfile(studentId);
      allow delete: if false;
    }
    match /studentGearRewards/{receiptId} {
      allow get: if isReportAdmin() || (isReportMember()
        && (!exists(/databases/$(database)/documents/studentGearRewards/$(receiptId)) || isGearOwner(resource.data.studentId)));
      allow list: if isGearOwner(resource.data.studentId) || isReportAdmin();
      allow create: if ((isGearOwner(request.resource.data.studentId)
        && gearReceiptValid(request.resource.data.studentId, receiptId, request.resource.data)
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.lastAction.type == 'reward')
        || (gearHistorySourceValid(request.resource.data.studentId, receiptId, request.resource.data)
        && request.resource.data.keys().hasOnly(['studentId', 'type', 'sourceId', 'sourcePath', 'day', 'dayIndex', 'coins', 'growthPoints', 'mode', 'attribution', 'createdAt'])
        && request.resource.data.mode == 'history' && request.resource.data.coins == gearPoints(request.resource.data.type)
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.lastAction.type == 'history'))
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.lastAction.id == receiptId
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(request.resource.data.studentId)).data.balance == gearBefore(request.resource.data.studentId).balance + request.resource.data.coins;
      allow update: if isReportAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'growthPoints', 'evolutionMigratedAt', 'coinsBeforeUncap', 'uncappedAt'])
        && resource.data.coins <= gearPoints(resource.data.type)
        && request.resource.data.coins == gearPoints(resource.data.type)
        && (resource.data.coins == request.resource.data.coins || (request.resource.data.coinsBeforeUncap == resource.data.coins && request.resource.data.uncappedAt is string))
        && gearHistorySourceValid(resource.data.studentId, receiptId, request.resource.data)
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(resource.data.studentId)).data.lastAction.type == 'history'
        && getAfter(/databases/$(database)/documents/studentGearProfiles/$(resource.data.studentId)).data.lastAction.id == receiptId
        && gearHistoryChange(resource.data.studentId, getAfter(/databases/$(database)/documents/studentGearProfiles/$(resource.data.studentId)).data, gearBefore(resource.data.studentId));
      allow delete: if false;
    }
    match /gearHistoryMigrations/{migrationId} {
      allow read, write: if isReportAdmin();
    }
    match /weeklyReports/{reportId} {
      allow read: if isReportMember();
      // Todas as alterações passam pela API, que verifica autor/admin e conteúdo do arquivo.
      allow write: if false;
    }
    match /weeklyReportReads/{uid}/reports/{reportId} {
      allow read: if isReportMember() && request.auth.uid == uid;
      allow write: if false;
    }
    match /weeklyReportRecipients/{recipientId} {
      allow read: if isReportAdmin();
      allow write: if false;
    }
    match /weeklyReportEmailJobs/{jobId} {
      allow read, write: if false;
    }
    match /weeklyReportCleanup/{cleanupId} {
      allow read, write: if false;
    }
    match /weeklyReportExpectations/{periodId} {
      allow read, write: if false;
    }
    match /automaticReminderJobs/{jobId} {
      allow read, write: if false;
    }
    match /settings/automatic_reminders {
      allow read, write: if false;
    }
    match /settings/reminder_scheduler {
      allow read, write: if false;
    }
  }
}
