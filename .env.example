# FRONTEND (Vite): valores públicos; ativar apenas depois de configurar contas/API/regras.
VITE_FIREBASE_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gestao-new-gears.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gestao-new-gears
VITE_REPORTS_API_BASE=/api/reports

# BACKEND (Cloudflare Pages Functions): configurar no painel Cloudflare, NÃO com prefixo VITE_.
# Para desenvolvimento com Wrangler, colocar estes valores em .dev.vars (ignorado pelo Git).
# Variáveis de um .env do Vite não configuram automaticamente o runtime das Functions.
FIREBASE_PROJECT_ID=gestao-new-gears
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=weekly-reports
EMAIL_API_KEY=
EMAIL_FROM="New Gears <relatorios@SEU-DOMINIO>"
APP_URL=https://SEU-SITE.pages.dev
